/* McStudio SARibbon overlay
 * Applied only to the McStudio SARibbonBar subtree after the built-in SARibbon
 * theme. Tokens are replaced by McStudioTheme.cpp.
 */

SARibbonBar#McStudioSARibbonBar {
    background-color: #f6f8fb;
    border: none;
    color: @mc-text-primary;
}

SARibbonCategory {
    background-color: #ffffff;
    border-top: none;
    border-bottom: 1px solid #d7dde7;
}

SARibbonPanel {
    background-color: #ffffff;
    border-left: 1px solid transparent;
    border-top: none;
    border-bottom: none;
    border-right: 1px solid #cbd3df;
    color: @mc-text-secondary;
    min-width: @mc-panel-min-widthpx;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 4px;
}

SARibbonPanel:hover {
    background-color: #fbfcff;
}

SARibbonPanel > SARibbonButtonGroupWidget {
    border: none;
    background-color: transparent;
    spacing: 2px;
}

SARibbonPanelLabel {
    background-color: transparent;
    color: @mc-text-secondary;
    font-size: 11px;
    min-height: @mc-panel-title-heightpx;
    max-height: @mc-panel-title-heightpx;
    padding: 0px 0px 2px 0px;
    margin: 0px;
    border: none;
    qproperty-alignment: AlignCenter;
}

SARibbonSeparatorWidget {
    color: @mc-border-subtle;
}

SARibbonCategory > SARibbonSeparatorWidget {
    color: @mc-border-subtle;
    margin-top: 8px;
    margin-bottom: 8px;
}

/* SARibbonToolButton is fully self-painted: paintEvent()/calcDrawRects() lay
   out the icon/text from the widget's rect() plus SARibbon's internal mSpacing.
   ROOT CAUSE of the "small icon obscured" bug: a default-state
   `border: 1px solid transparent` makes Qt's QStyleSheetStyle treat the button
   as a CSS-box widget and hand SARibbon a contentsRect() already shrunk by the
   1px border; SARibbon then adds its own mSpacing, so the icon is inset twice
   and its left edge is clipped. The vendored office2021.qss avoids this by
   using `border: none` in the default state and only adding a border on
   hover/pressed/checked. We mirror that exactly. Padding matches the official
   `0 2px` so spacing stays owned by SARibbon (mSpacing / panelSpacing) and icon
   size by setPanelToolButtonIconSize(). */
SARibbonToolButton,
SARibbonButtonGroupWidget > QToolButton,
SARibbonPanelOptionButton {
    border: none;
    color: @mc-text-primary;
    background-color: transparent;
    min-width: @mc-button-min-widthpx;
    padding: 0px 2px;
    margin: 1px 2px;
}

/* Hover/pressed feedback uses background + rounded corners only, and keeps
   `border: none`. Adding a real 1px border here would make QStyleSheetStyle
   shrink the contentsRect by 1px on hover and re-clip the icon (the icon sits
   only mSpacing=1px from the widget's left edge), causing a visible left-edge
   clip that flickers on hover. Background-only feedback avoids that entirely. */
SARibbonToolButton:hover,
SARibbonButtonGroupWidget > QToolButton:hover,
SARibbonPanelOptionButton:hover {
    border: none;
    border-radius: 5px;
    background-color: @mc-bg-hover;
}

SARibbonToolButton:pressed,
SARibbonToolButton:checked,
SARibbonButtonGroupWidget > QToolButton:pressed,
SARibbonButtonGroupWidget > QToolButton:checked,
SARibbonPanelOptionButton:pressed {
    border: none;
    border-radius: 5px;
    background-color: @mc-bg-pressed;
}

SARibbonToolButton:disabled,
SARibbonButtonGroupWidget > QToolButton:disabled {
    color: @mc-text-disabled;
    background-color: transparent;
    border: 1px solid transparent;
}

SARibbonTabBar {
    background-color: #f6f8fb;
    color: @mc-text-primary;
    margin-left: 10px;
}

SARibbonTabBar::tab {
    color: @mc-text-primary;
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    border-radius: 0px;
    padding-left: @mc-tab-padding-hpx;
    padding-right: @mc-tab-padding-hpx;
    padding-top: 4px;
    padding-bottom: 3px;
    margin-top: 0px;
    margin-left: 0px;
    margin-right: 3px;
    margin-bottom: 0px;
    min-width: @mc-tab-min-widthpx;
}

SARibbonTabBar::tab:hover,
SARibbonTabBar::tab:hover:!selected {
    color: @mc-text-primary;
    background-color: #f1f5fb;
    border: none;
    border-bottom: 3px solid #bcd0ee;
}

SARibbonTabBar::tab:selected,
SARibbonTabBar::tab:selected:hover {
    color: @mc-accent;
    background-color: transparent;
    border: none;
    border-bottom: 3px solid @mc-accent;
    font-weight: 600;
}

SARibbonStackedWidget {
    background-color: #ffffff;
    border-top: none;
    border-left: none;
    border-right: none;
    border-bottom: 1px solid #d7dde7;
}

SARibbonMenu {
    background-color: @mc-bg-surface;
    color: @mc-text-primary;
    border: 1px solid @mc-border-subtle;
}

SARibbonMenu::item:selected {
    background-color: @mc-bg-hover;
}
